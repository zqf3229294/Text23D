# Provider selection: mock, openai, anthropic, deepseek, or openai_compatible.
TEXT23D_LLM_PROVIDER=mock
TEXT23D_LLM_MAX_TOKENS=8000

# Local persistence.
TEXT23D_DATABASE_PATH=./data/text23d.sqlite3
TEXT23D_STORAGE_DIR=./data/artifacts

# CAD backend: cadquery exports STEP + GLB. freecad exports FCStd + STEP + STL preview.
TEXT23D_CAD_KERNEL=cadquery

# Generation mode: script runs one generated Python script. agent is an opt-in
# FreeCAD tool loop for TEXT23D_CAD_KERNEL=freecad.
TEXT23D_GENERATION_MODE=script

# Image input is currently a guarded future feature. Keep off for text-only mode.
TEXT23D_IMAGE_INPUT_ENABLED=false
TEXT23D_IMAGE_MAX_UPLOAD_BYTES=5242880
TEXT23D_IMAGE_MAX_COUNT_PER_MESSAGE=4
TEXT23D_IMAGE_ALLOWED_CONTENT_TYPES=["image/png","image/jpeg","image/webp"]

# Local CadQuery runner.
TEXT23D_CAD_RUNNER_TIMEOUT_SECONDS=90

# Optional overrides. Leave blank to use the backend Python and the repo runner script.
# Use CAD_RUNNER_PYTHON when CadQuery is installed in a separate Python environment.
TEXT23D_CAD_RUNNER_PYTHON=
TEXT23D_CAD_RUNNER_SCRIPT=

# Local FreeCAD runner. For persistent agent mode on Windows, prefer FreeCAD's
# bundled python.exe so the backend can use stdin/stdout worker communication.
# FreeCADCmd.exe can still be used for one-shot script mode.
TEXT23D_FREECAD_PYTHON=
TEXT23D_FREECAD_RUNNER_SCRIPT=

# FreeCAD agent backend. worker uses a persistent GUI-capable FreeCAD process.
# replay keeps the older per-tool FreeCADCmd script replay path.
TEXT23D_FREECAD_AGENT_BACKEND=worker
# Optional fallback when TEXT23D_FREECAD_PYTHON is not set. On Windows,
# FreeCAD.exe may open the GUI without answering the worker protocol.
TEXT23D_FREECAD_GUI_EXECUTABLE=
TEXT23D_FREECAD_WORKER_SCRIPT=
# pyvista renders backend PNG screenshots from temporary FreeCAD STL meshes and
# falls back to a CPU STL renderer when VTK/OpenGL is unavailable. summary
# returns a stable SVG object summary. gui tries FreeCADGui PNG screenshots.
TEXT23D_FREECAD_WORKER_VIEW_BACKEND=pyvista
TEXT23D_FREECAD_WORKER_TIMEOUT_SECONDS=60
TEXT23D_FREECAD_SESSION_IDLE_TIMEOUT_SECONDS=900

# FreeCAD agent limits. Agent mode V1 supports mock or Anthropic providers.
TEXT23D_AGENT_MAX_TOOL_CALLS=30
TEXT23D_AGENT_MAX_RUNTIME_SECONDS=300
TEXT23D_AGENT_MAX_CODE_CHARS=12000

# OpenAI provider. Set a model supported by your account.
TEXT23D_OPENAI_API_KEY=
TEXT23D_OPENAI_MODEL=gpt-4.1

# Anthropic provider. Set a model supported by your account.
TEXT23D_ANTHROPIC_API_KEY=
TEXT23D_ANTHROPIC_MODEL=claude-sonnet-4-5
# Enables automatic prompt caching for Anthropic FreeCAD agent loops.
TEXT23D_ANTHROPIC_AGENT_PROMPT_CACHE=false
# Use 5m first; 1h costs more and is useful for long pauses between turns.
TEXT23D_ANTHROPIC_AGENT_PROMPT_CACHE_TTL=5m

# DeepSeek provider. V4 Flash is the lower-cost default; use deepseek-v4-pro for higher capability.
TEXT23D_DEEPSEEK_API_KEY=
TEXT23D_DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT23D_DEEPSEEK_MODEL=deepseek-v4-flash
# Default false because many DeepSeek chat models accept text-only messages.
TEXT23D_DEEPSEEK_SUPPORTS_IMAGES=false

# Generic OpenAI-compatible provider.
TEXT23D_OPENAI_COMPATIBLE_API_KEY=
TEXT23D_OPENAI_COMPATIBLE_BASE_URL=
TEXT23D_OPENAI_COMPATIBLE_MODEL=
TEXT23D_OPENAI_COMPATIBLE_SUPPORTS_IMAGES=false
