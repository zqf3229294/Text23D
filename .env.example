# Provider selection: mock, openai, or anthropic.
TEXT23D_LLM_PROVIDER=mock

# Local persistence.
TEXT23D_DATABASE_PATH=./data/text23d.sqlite3
TEXT23D_STORAGE_DIR=./data/artifacts

# Local CadQuery runner.
TEXT23D_CAD_RUNNER_TIMEOUT_SECONDS=90

# Optional overrides. Leave blank to use the backend Python and the repo runner script.
# Use CAD_RUNNER_PYTHON when CadQuery is installed in a separate Python environment.
TEXT23D_CAD_RUNNER_PYTHON=
TEXT23D_CAD_RUNNER_SCRIPT=

# OpenAI provider. Set a model supported by your account.
TEXT23D_OPENAI_API_KEY=
TEXT23D_OPENAI_MODEL=gpt-4.1

# Anthropic provider. Set a model supported by your account.
TEXT23D_ANTHROPIC_API_KEY=
TEXT23D_ANTHROPIC_MODEL=claude-sonnet-4-5
